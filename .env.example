# Local development only. Production values should be Cloudflare/GitHub secrets.
ALLOW_LOCAL_DEV=true
DASHBOARD_USERNAME=mcsteeladmin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
ALLOWED_EMAILS=marketing@example.com
COLLECTOR_SECRET=replace-with-a-long-random-value
